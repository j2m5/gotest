DATABASE_URL=
# Backup/restore tools; empty uses PATH. Use the server's PostgreSQL major version.
# Windows example: C:/Program Files/PostgreSQL/18/bin
POSTGRES_BIN_DIR=
# Explicit separate empty target for db:restore; never defaults to DATABASE_URL.
RESTORE_DATABASE_URL=
APP_PORT=8081
APP_ENV=local
# Relative to the selected app dotenv file, or startup cwd in environment-only mode.
STATIC_DIR=frontend/dist
# Origin visible in the browser and used by email links.
# For Vite dev use http://localhost:5173. Production must use HTTPS.
PUBLIC_URL=http://localhost:8081
# IPs/CIDRs of proxies allowed to supply X-Forwarded-For, separated by commas.
# Empty trusts no proxy. Example for a local proxy only: 127.0.0.1/32,::1/128
TRUSTED_PROXIES=
# Fixed server lifetime for ordinary login (browser-session cookie).
SESSION_TTL=24h
# Fixed server and persistent-cookie lifetime when Remember me is selected.
# Must be at least SESSION_TTL; both lifetimes must be positive and <=8760h.
REMEMBER_ME_TTL=720h
VERIFICATION_TTL=24h
# One-use password recovery link; positive duration up to 24h.
PASSWORD_RESET_TTL=30m

# local writes a separate .eml per message into a gitignored directory.
MAIL_DRIVER=local
MAIL_FROM=noreply@example.test
# Uses the same base directory as STATIC_DIR; absolute paths are also accepted.
MAIL_DIR=.local/mail
# Required: 32 random bytes encoded in base64. Back up this key and keep it
# unchanged while pending mail jobs exist; the database cannot decrypt them alone.
MAIL_QUEUE_KEY=

# MAIL_DRIVER=smtp for real delivery. Set a real MAIL_FROM accepted by the server.
SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (normally port 587), or tls (normally port 465).
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=10s
