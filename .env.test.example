# Disposable local test database from compose.test.yml; not application credentials.
TEST_DATABASE_URL=postgres://gotest_test:gotest_test@127.0.0.1:55432/gotest_test?sslmode=disable
# Test role needs CREATEDB for isolated backup/restore tests; this Compose role has it.
# pg_dump/pg_restore of the server major version, e.g. C:/Program Files/PostgreSQL/18/bin
POSTGRES_BIN_DIR=
# Absolute path, for example C:/Program Files/Google/Chrome/Application/chrome.exe
# On Linux: /usr/bin/google-chrome
CHARACTER_BROWSER_BINARY=
# Optional screenshots; stays under the ignored local directory.
CHARACTER_SCREENSHOT_DIR=
